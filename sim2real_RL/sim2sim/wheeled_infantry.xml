  <equality>
    <connect name="left_loop1" site1="left_node_site" site2="left_upper_site" solref="0.008 1" solimp="0.95 0.99 0.002 0.5 2" />
    <connect name="left_loop2" site1="left_parallel_site" site2="left_lower_site" solref="0.008 1" solimp="0.95 0.99 0.002 0.5 2" />
